{
  "schemaVersion": 1,
  "id": "velaclient",
  "version": "${version}",
  "name": "Vela Client",
  "description": "An all-in-one client for Minecraft 26.2: a configurable HUD, visual effects, PvP helpers, a music player with lyrics and quality-of-life tools, in one mod with one settings menu.",
  "authors": ["sqwat"],
  "license": ["MIT", "LGPL-3.0-or-later"],
  "icon": "assets/velaclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.sqwat.vela.VelaClient", "de.johni0702.minecraft.bobby.Bobby", "ru.vidtu.ias.platform.IFabric", "com.terraformersmc.modmenu.ModMenu"],
    "voicechat": ["dev.sqwat.vela.core.VelaVoicePlugin"],
    "modmenu": ["dev.sqwat.vela.core.VelaModMenu"]
  },
  "mixins": ["velaclient.mixins.json", "bobby.mixins.json", "ias.mixins.json", "mixins.modmenu.json"],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "breaks": {
    "ias": "*",
    "bobby": "*",
    "modmenu": "*"
  }
}
